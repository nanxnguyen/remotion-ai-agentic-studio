# Sao chép thành .env rồi điền key. KHÔNG đưa file .env lên GitHub.
ANTHROPIC_API_KEY=sk-ant-...

# Ngân sách (USD). Hết hạn mức thì xưởng tự dừng gọi Claude, các bước chờ trong khay.
DAILY_CAP_USD=3
VIDEO_CAP_USD=0.8
MAX_CONCURRENT=2

# Kênh và các bước gọi Claude thật (các bước sau vẫn mô phỏng)
REAL_CHANNEL=hcl
REAL_STEPS=research,script,review-script
WEB_SEARCH=1
MAX_SEARCHES=3

# Đặt 1 để thử toàn bộ luồng bằng Claude giả, không tốn tiền
XV_FAKE_CLAUDE=0

# Chạy trên máy: giữ 127.0.0.1. Lên VPS: HOST=0.0.0.0 và BẮT BUỘC đặt XV_TOKEN dài, khó đoán
PORT=8787
HOST=127.0.0.1
XV_TOKEN=
