      "mix_gain": 1.898
    },
    {
      "id": 5,
      "audio_file": "s5.mp3",
      "voice_code": "n_hn_male_ngankechuyen_ytstable_vc",
      "audio_seconds": 3.888,
      "text": "Họ thấy ba cô gái đứng bên vệ đường, tay vẫy xin quá giang.",
      "sha256": "e421184b01ab2ca640bc75fc8b8af66e798a812e1e5177b0d0bcd35020df401e",
      "start_seconds": 17.856,
      "rendered_audio_seconds": 3.866,
