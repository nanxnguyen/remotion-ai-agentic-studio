{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotion-pipeline-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [
    {"binding": "DB", "database_name": "remotion-monitor", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations"}
  ]
}
