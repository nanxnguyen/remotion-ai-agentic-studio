{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotion-pipeline-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [
    {"binding": "DB", "database_name": "remotion-monitor", "database_id": "d5e108b6-612c-47b3-878f-ddf9811ff9ec", "migrations_dir": "migrations"}
  ]
}
